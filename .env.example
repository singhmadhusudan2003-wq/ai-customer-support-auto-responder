# =============================================================================
# AI Customer Support Auto-Responder — Environment Configuration
# Copy this file to `.env` (inside backend/, or project root for docker-compose)
# and adjust values as needed. Sensible defaults are used if a variable is
# omitted, so the app runs out-of-the-box without any changes.
# =============================================================================

# --- App ---
ENVIRONMENT=development
DEBUG=true

# --- Security / JWT ---
# IMPORTANT: change this to a long random string before deploying to production
SECRET_KEY=CHANGE_ME_SUPER_SECRET_KEY_IN_PRODUCTION_9f8a7d6c5b4a
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Database ---
# Default uses local SQLite file, created automatically on first run.
DATABASE_URL=sqlite:///./support.db

# --- Default admin account (auto-seeded on first run) ---
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=Admin@123
DEFAULT_ADMIN_NAME=Support Admin

# --- AI confidence / escalation ---
CONFIDENCE_ESCALATION_THRESHOLD=0.45

# --- Optional: OpenAI (for LLM-generated replies instead of templates) ---
USE_OPENAI=false
OPENAI_API_KEY=

# --- Optional: Ollama (local LLM, e.g. Llama 3 / Mistral) ---
USE_OLLAMA=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
